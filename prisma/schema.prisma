generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image          String?
  emailVerified  DateTime?
  createdAt      DateTime @default(now())
  books     Book[]
  memberships   BookMember[]
  expenseShares ExpenseShare[]
  accounts  Account[]
  sessions  Session[]
}

model Book {
  id             String          @id @default(cuid())
  name           String
  emoji          String          @default("📒")
  resetDay       Int             @default(1) // tracker period start day-of-month (1-28, or 31 = last day)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]
  members        BookMember[]
  invites        BookInvite[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
}

model BookMember {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // "owner" | "member"
  isDefault Boolean  @default(false) // this member's default book — per-user, not shared
  createdAt DateTime @default(now())

  @@unique([bookId, userId])
  @@index([userId])
  @@index([bookId])
}

model BookInvite {
  id             String   @id @default(cuid())
  bookId         String
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  email          String   // invitee gmail — resolved to a member on their next login, no email sent
  role           String   @default("member")
  invitedByEmail String?
  createdAt      DateTime @default(now())

  @@unique([bookId, email])
  @@index([email])
}

model Transaction {
  id             String   @id @default(cuid())
  amount         Int      // satang (THB × 100)
  type           String   // "income" | "expense"
  category       String   // "Food" | "Transport" | "Bills" | "Shopping" | "Transfer" | "Salary" | "Other"
  date           DateTime
  note           String?
  merchantName   String?
  immichAssetId  String?
  confidenceJson Json?
  splitMode      String?  // null = not split, "equal" | "manual"
  bookId         String
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  shares         ExpenseShare[]
  createdAt      DateTime @default(now())

  @@index([bookId])
  @@index([bookId, date])
}

model ExpenseShare {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountOwed    Int         // satang (THB × 100)
  slipAssetId   String?     // Immich asset id of the uploaded slip
  paidAt        DateTime?
  createdAt     DateTime    @default(now())

  @@unique([transactionId, userId])
  @@index([userId])
  @@index([transactionId])
}

model RecurringRule {
  id            String        @id @default(cuid())
  bookId        String
  book          Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  amount        Int           // satang (THB × 100)
  type          String        // "income" | "expense"
  category      String
  note          String?
  merchantName  String?
  dayOfMonth    Int           // 1-31, clamped to month length when generating
  startPeriod   String        // "YYYY-MM" — first month this rule is active
  endPeriod     String?       // "YYYY-MM" — last active month, null = open-ended
  lastRunPeriod String?       // "YYYY-MM" — last period confirmed or skipped
  isActive      Boolean       @default(true)
  transactions  Transaction[]
  createdAt     DateTime      @default(now())

  @@index([bookId, isActive])
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
